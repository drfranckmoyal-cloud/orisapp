{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oris.local/schemas/transcript_segment.schema.json",
  "title": "TranscriptSegment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segment_id",
    "start_ms",
    "end_ms",
    "speaker_role",
    "text",
    "confidence",
    "is_final"
  ],
  "properties": {
    "segment_id": {
      "type": "string"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "speaker_role": {
      "type": "string",
      "enum": [
        "practitioner",
        "patient",
        "assistant",
        "companion",
        "unknown"
      ]
    },
    "text": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "is_final": {
      "type": "boolean"
    }
  }
}