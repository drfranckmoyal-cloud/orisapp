APP_ENV=local
DATABASE_URL=postgresql://oris:oris@localhost:5432/oris
REDIS_URL=redis://localhost:6379/0
STT_PROVIDER=mock
CLINICAL_EXTRACTION_PROVIDER=mock
DOCUMENT_GENERATION_PROVIDER=mock
AUDIO_RETENTION_MODE=ephemeral
ENABLE_LIVE_TRANSCRIPT=false
ENABLE_VOICE_CORRECTION=false
ENABLE_OPERATIVE_GENERATION=true
PATIENT_INFORMATION_MODE=confirm
AUDIO_SINK=local_temp
# Transcription externe (banc d'essai M4) : désactivée par défaut
ALLOW_EXTERNAL_STT=false
STT_USE_GLOSSARY=true
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
# Extraction clinique (M5) : désactivée par défaut
CLINICAL_EXTRACTION_PROVIDER=mock
ALLOW_EXTERNAL_LLM=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
