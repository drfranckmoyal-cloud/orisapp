<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Écoute poursuivie écran verrouillé ou app en arrière-plan (spec §70). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Le serveur Oris tourne sur le Mac du cabinet, joint en HTTP sur le réseau local.
	     Seules les adresses locales sont permises en clair ; tout le reste reste HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_oris._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Oris envoie l’écoute au serveur Oris du Mac du cabinet, sur le Wi-Fi local.</string>
</dict>
</plist>
